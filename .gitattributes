# Mantém finais de linha do Linux mesmo clonando no Windows
# (scripts com CRLF quebram no bash dentro dos contêineres)
*.sh            text eol=lf
*.conf          text eol=lf
*.py            text eol=lf
*.yml           text eol=lf
*.hosts         text eol=lf
Corefile        text eol=lf
Dockerfile      text eol=lf
*.txt           text eol=lf
*.key           text eol=lf
db.*            text eol=lf
